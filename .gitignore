# Fichiers générés par `vite build` (et le rendu côté serveur)
dist
dist-ssr

# Variables d'environnement locales
# Fichiers .env.local, .env.development.local, etc. propres à chaque poste
*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Variables d'environnement
# Fichiers .env propres à chaque poste
.env
.env.*
!.env.example

# Éditeurs / IDE
# VS Code : on ignore tout sauf les extensions recommandées à l'équipe
.vscode/*
!.vscode/extensions.json
# JetBrains (WebStorm, IntelliJ…)
.idea
